{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xops version",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/xops",
      "args": ["version"],
      "console": "integratedTerminal"
    },
    {
      "name": "finops version",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/finops",
      "args": ["version"],
      "console": "integratedTerminal"
    },
    {
      "name": "finops enrich validate (demo taxonomy)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/finops",
      "args": ["enrich", "validate", "--taxonomy", "finops/enrich/testdata/demo-taxonomy.yaml"],
      "console": "integratedTerminal"
    },
    {
      "name": "finops enrich map (demo)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/finops",
      "args": ["enrich", "map", "--taxonomy", "finops/enrich/testdata/demo-taxonomy.yaml", "--from-accounts", "finops/enrich/testdata/demo-accounts.jsonl"],
      "console": "integratedTerminal"
    },
    {
      "name": "xops sense aws-accounts (--mock)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/xops",
      "args": ["sense", "aws-accounts", "--mock"],
      "console": "integratedTerminal"
    },
    {
      "name": "record: tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/record",
      "console": "integratedTerminal"
    }
  ]
}
