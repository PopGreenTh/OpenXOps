{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xops version",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/xops",
      "args": ["version"],
      "console": "integratedTerminal"
    },
    {
      "name": "finops version",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/finops",
      "args": ["version"],
      "console": "integratedTerminal"
    },
    {
      "name": "xops sense aws-accounts (--mock)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/xops",
      "args": ["sense", "aws-accounts", "--mock"],
      "console": "integratedTerminal"
    },
    {
      "name": "xops sense aws-accounts (discover)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/xops",
      "args": ["sense", "aws-accounts", "--mock"],
      "console": "integratedTerminal",
      "stopOnEntry": false
    },
    {
      "name": "record: tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/record",
      "console": "integratedTerminal"
    }
  ]
}
